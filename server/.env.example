# Server
NODE_ENV=development
PORT=3001

# MySQL (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/aromawrap"

# Session (express-session). In production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_NAME=aromawrap.sid

# CORS � comma-separated origins. Required in production, https only, e.g.
#   CORS_ORIGIN=https://aromawrap.co.in,https://www.aromawrap.co.in
CORS_ORIGIN=http://localhost:8080

# Number of reverse proxies in front of Express (1 behind nginx). Defaults to 1 in production, 0 otherwise.
TRUST_PROXY=0

# File uploads (Multer destination)
UPLOAD_DIR=uploads

# SMTP (password reset emails). Required for password reset outside NODE_ENV=development;
# in development only, the code is printed to the console when SMTP is unset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AromaWrap <noreply@example.com>"
